<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<LangVersion>latest</LangVersion>
		<Version>1.0.0-alpha.3</Version>
		<Authors>Lennie Wennerlund</Authors>
		<Company>LiSoLi</Company>
		<PackageId>LiTools.Helpers.VersionHandling</PackageId>
		<Description>LiTools Version handling</Description>		
	</PropertyGroup>
	
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<PackageReference Include="Microsoft.CodeAnalysis" Version="5.0.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
		<PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	<AdditionalFiles Include="../stylecop.json" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="System.Net.Http.Json" Version="10.0.1" />
	</ItemGroup>

	<!-- Build info properties (can be overridden on the command line or by CI) -->
	<PropertyGroup>
		<BuildDate>missing</BuildDate>
		<BuildSite>missing</BuildSite>
		<BuildImage>missing</BuildImage>
		<!-- PackageReleaseNotes as JSON so it is machine-readable in the generated nuspec -->
		<PackageReleaseNotes>{"BuildDate":"$(BuildDate)","BuildSite":"$(BuildSite)","BuildImage":"$(BuildImage)"}</PackageReleaseNotes>
	</PropertyGroup>

	<Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">
		<PropertyGroup>
			<_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.Generated.cs</_BuildInfoFile>
			<_BuildInfoText>
				<![CDATA[// <auto-generated />
namespace VersionData
{
    internal static class BuildInfo
    {
        public const string BuildDate = "$(BuildDate)";
        public const string BuildSite = "$(BuildSite)";
        public const string BuildImage = "$(BuildImage)";
    }
}]]>
			</_BuildInfoText>
			<_BuildInfoLines>$([System.Text.RegularExpressions.Regex]::Split($(_BuildInfoText), '\r?\n'))</_BuildInfoLines>

			<!-- JSON content file generation -->
			<_BuildInfoJsonFile>$(IntermediateOutputPath)buildinfo.json</_BuildInfoJsonFile>
			<_BuildInfoJsonText>{"BuildDate":"$(BuildDate)","BuildSite":"$(BuildSite)","BuildImage":"$(BuildImage)"}</_BuildInfoJsonText>
		</PropertyGroup>

		<WriteLinesToFile File="$(_BuildInfoFile)" Overwrite="true" Encoding="UTF-8" Lines="$(_BuildInfoLines)" />
		<WriteLinesToFile File="$(_BuildInfoJsonFile)" Overwrite="true" Encoding="UTF-8" Lines="$(_BuildInfoJsonText)" />

		<ItemGroup>
			<Compile Include="$(_BuildInfoFile)">
				<Link>Generated\BuildInfo.Generated.cs</Link>
				<AutoGen>true</AutoGen>
				<DesignTime>true</DesignTime>
			</Compile>
			<!-- Include the generated JSON as content to be packed into the NuGet package under contentFiles -->
			<None Include="$(_BuildInfoJsonFile)">
				<Pack>true</Pack>
				<PackagePath>contentFiles\any\any\</PackagePath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
		</ItemGroup>
	</Target>

	<!-- Generate assembly metadata attributes so package consumers can inspect build info via AssemblyMetadataAttribute -->
	<Target Name="GenerateAssemblyBuildMetadata" BeforeTargets="BeforeCompile">
		<PropertyGroup>
			<_AssemblyInfoFile>$(IntermediateOutputPath)BuildInfo.AssemblyInfo.cs</_AssemblyInfoFile>
			<_AssemblyInfoText>
				<![CDATA[// <auto-generated />
using System.Reflection;

[assembly: AssemblyMetadata("BuildDate", "$(BuildDate)")]
[assembly: AssemblyMetadata("BuildSite", "$(BuildSite)")]
[assembly: AssemblyMetadata("BuildImage", "$(BuildImage)")]
]]>
			</_AssemblyInfoText>
			<_AssemblyInfoLines>$([System.Text.RegularExpressions.Regex]::Split($(_AssemblyInfoText), '\r?\n'))</_AssemblyInfoLines>
		</PropertyGroup>

		<WriteLinesToFile File="$(_AssemblyInfoFile)" Overwrite="true" Encoding="UTF-8" Lines="$(_AssemblyInfoLines)" />

		<ItemGroup>
			<Compile Include="$(_AssemblyInfoFile)">
				<Link>Generated\BuildInfo.AssemblyInfo.cs</Link>
				<AutoGen>true</AutoGen>
				<DesignTime>true</DesignTime>
			</Compile>
		</ItemGroup>
	</Target>
	
</Project>
